datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int      @id @default(autoincrement())
  name            String?
  email           String   @unique
  password        String
  affiliateCode   String   @unique
  discountBalance Float    @default(0) // الرصيد بالجنيه
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  referredUsers   Int      @default(0) // عدد العملاء اللي اشتروا
}
