datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int      @id @default(autoincrement())
  name            String?
  email           String   @unique
  password        String
  affiliateCode   String   @unique
  discountBalance Float    @default(0) // الرصيد بالجنيه
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  referredUsers   Int      @default(0) // عدد العملاء اللي اشتروا
  isAdmin         Boolean  @default(false)
  designs         Design[]
}

model Design {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  frontDesign String   // JSON string or base64 representation
  backDesign  String   
  tshirtColor String   @default("#ffffff")
  imageUrl    String?  // Optional snapshot/preview
  createdAt   DateTime @default(now())
  purchases   Int      @default(0)

  user        User     @relation(fields: [userId], references: [id])
}
